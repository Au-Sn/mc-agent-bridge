# dsh.env.example -- MC Agent Bridge 的**环境事实模板**
#
# 用法（★首次使用 / 换机器 / 换整合包✗★）：
#     cp dsh.env.example dsh.env        # Windows PowerShell: Copy-Item dsh.env.example dsh.env
#   ⇒ 然后把下面的占位符改成**你自己机器**的值；`dsh.env` 是**本机配置**（不进版本库），
#      模板（本文件）才进库。
#
# 读取优先级（tools/paths.py）：环境变量 > dsh.env > 内置默认
#   · 机器相关项（MC_HOME/INSTANCE_NAME/PACK_NAME/SAVE_NAME）**没有内置默认**：
#     没配置就会**明确报错/告警**（NotConfigured），**不会**偷偷用别人的本机路径。
#   · 有安全默认的项：BOT_NAME=Bot、DSH_PORT=8766、GATEWAY_PORT=8765。
#
# 每一项都可以用**同名环境变量**覆盖（例：MC_HOME=... 或 DSH_GAME_DIR=...）。

# ── 游戏实例（必填）─────────────────────────────────────────────────────
# PCL2 的版本实例目录（里面有 mods/ saves/ logs/ config/）；Windows 路径含空格不用引号
MC_HOME=<你的 PCL2 实例目录，一般是 …\.minecraft\versions\<实例名>>
# 实例目录名（人读 + doctor 核对；一般就是 MC_HOME 的最后一段）
INSTANCE_NAME=<实例目录名>
# 整合包简称（人读/报告用，可留空）
PACK_NAME=<整合包简称>

# ── 存档（必填；agent 的磁盘后备通道要用它）─────────────────────────────
# 存档目录名：MC_HOME/saves/<SAVE_NAME>/ 必须存在
SAVE_NAME=<你的存档目录名>

# ── 假人 / 端口（有默认，通常不用改）────────────────────────────────────
BOT_NAME=Bot
DSH_PORT=8766
GATEWAY_PORT=8765

# ── 模组版本单一真源（相对仓库根；一般不用改）──────────────────────────
MOD_VERSION_FILE=mod/gradle.properties

# ── 可选：HTTP token 文件（2.56+ 写通道；/health 除外）─────────────────
# 留空则按顺序找：<MC_HOME>/config/dshbridge/http_token.txt → state/http_token.txt
# HTTP_TOKEN_FILE=<token 文件的绝对路径>

# ── 可选：大脑层接缝（不配就只影响大脑层，工具/游戏侧不受影响）─────────
# dsh 可执行文件（找不到会用 PATH 与常见安装位置）
# DSH_EXE=<dsh 可执行文件路径>
# dsh 的 lib/bin.js（ACP 常驻客户端用；找不到会明确报"需要配置 DSH_BIN_JS"）
# DSH_BIN_JS=<dsh 的 lib/bin.js 绝对路径>
# node 可执行文件（找不到会用 PATH）
# DSH_NODE=<node 可执行文件路径>
